PORT=3000
DATABASE_URL=postgres://postgres:postgres_dev@localhost:5432/estacionamientos
JWT_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio
CLIENT_URL=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost

# Opcional: envio real de correos para recuperacion de contrasena.
# Si se omite, el enlace de recuperacion queda registrado en los logs del backend (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sistema de Estacionamientos <no-reply@estacionamientos.local>"

# Opcional: pasarela de pago Webpay Plus (Transbank). Si se omite, se usa el ambiente de integracion/pruebas publico de Transbank.
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_ENV=integration
